---
import Base from '../../layouts/Base.astro';
import Photo from '../../components/Photo.astro';
import CloseBand from '../../components/CloseBand.astro';
import { projects } from '../../data/projects';

export function getStaticPaths() {
  return projects.map((project) => ({ params: { slug: project.slug }, props: { project } }));
}

const { project } = Astro.props;
const description = `${project.name}. ${project.type}. ${project.status}, ${project.dates}.`;
const work = project.kind === 'renovation' ? 'renovation' : 'custom-home';
---
<Base
  title={`${project.name} | Heartwood Homes`}
  description={description}
>
  <article>
    <header class="section">
      <div class="container stack">
        <h1>{project.name}</h1>
        <p class="muted">{project.type}</p>
        <p>{project.status} · {project.dates}</p>
        <p class="lede measure">{project.summary}</p>
      </div>
    </header>
    <Photo
      src={project.image}
      alt={project.imageAlt}
      credit={project.credit}
      rendering={project.rendering}
      sizes="100vw"
      priority
    />
    <div class="container stack section">
      <p>
        <a class="text-link" href={project.serviceHref}>
          {project.kind === 'renovation' ? 'Renovations' : 'Custom homes'}
        </a>
        {' · '}
        <a class="text-link" href="/projects/">All projects</a>
      </p>
      {project.href && project.hrefLabel && (
        <p><a class="text-link" href={project.href}>{project.hrefLabel}</a></p>
      )}
    </div>
    <CloseBand href={`/contact/?work=${work}`} />
  </article>
</Base>
