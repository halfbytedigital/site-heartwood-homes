---
import Base from '../../layouts/Base.astro';
import CloseBand from '../../components/CloseBand.astro';
import ProjectStory from '../../components/ProjectStory.astro';
import { getGallery } from '../../data/galleries';
import { featuredFirst, projects } from '../../data/projects';

export function getStaticPaths() {
  return projects.map((project) => ({ params: { slug: project.slug }, props: { project } }));
}

const { project } = Astro.props;
const gallery = getGallery(project.slug);
const description = `${project.name}. ${project.type}. ${project.status}, ${project.dates}.`.slice(0, 155);
const work = project.kind === 'renovation' ? 'renovation' : 'custom-home';
const order = featuredFirst(projects.filter((item) => item.kind === project.kind));
const index = order.findIndex((item) => item.slug === project.slug);
const next = [1, 2].map((step) => order[(index + step) % order.length]).filter((item) => item && item.slug !== project.slug);
const link = project.href ?? gallery?.link ?? null;
const linkLabel = project.hrefLabel ?? (link ? 'The project site' : null);
---
<Base title={`${project.name} | Heartwood Homes`} description={description}>
  <article>
    <header class="section">
      <div class="container stack">
        <h1>{project.name}</h1>
        <p class="muted">{gallery?.projectType ?? project.type}</p>
        <p>{gallery?.status ?? project.status}{gallery?.dates || project.dates ? ` · ${gallery?.dates ?? project.dates}` : ''}</p>
        {gallery?.location && <p>{gallery.location}</p>}
        <p class="lede measure">{gallery?.description ?? project.summary}</p>
        {link && linkLabel && <p><a class="text-link" href={link}>{linkLabel}</a></p>}
      </div>
    </header>
    {gallery && gallery.shots.length > 0 ? (
      <ProjectStory gallery={gallery} next={next} />
    ) : null}
    <CloseBand href={`/contact/?work=${work}`} />
  </article>
</Base>
