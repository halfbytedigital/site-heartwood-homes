---
import Base from '../layouts/Base.astro';
import { renovationRows } from '../data/services';
import { renovationProjects } from '../data/projects';
import { getGallery } from '../data/galleries';
import Button from '../components/Button.astro';
import CloseBand from '../components/CloseBand.astro';
import AskProof from '../components/AskProof.astro';
import { Image } from 'astro:assets';
import ProjectShot from '../components/ProjectShot.astro';
import PhotoViewer from '../components/PhotoViewer.astro';
import { shotWidths } from '../data/galleries';

const bucket = getGallery('renovations');
---
<Base
  title="Home Renovations in Chattanooga | Heartwood Homes"
  description="Major renovations by Heartwood Homes in Chattanooga, from kitchens and bathrooms to the exterior."
>
  <section class="section">
    <div class="container stack">
      <h1>The same crew, on a house you already have.</h1>
      <p class="lede">Major renovations, from kitchens and bathrooms through the exterior.</p>
      {bucket?.description && <p class="measure">{bucket.description}</p>}
      <p class="measure">Kitchens and baths from a few different jobs.</p>
      <Button href="/contact/?work=renovation" cta>Start your home</Button>
      <AskProof />
    </div>
  </section>
  {bucket && (
    <section class="section">
      <div class="container stack">
        {bucket.shots.map((shot) => (
          <ProjectShot alt={shot.alt}>
            <Image src={shot.src} alt="" widths={shotWidths(shot)} sizes="(min-width: 800px) 1240px, 100vw" />
          </ProjectShot>
        ))}
      </div>
    </section>
  )}
  <PhotoViewer />

  <section class="band">
    <div class="container">
      <h2>What the work includes</h2>
      <div class="ruled">
        {renovationRows.map((row) => (
          <article>
            <h3>{row.title}</h3>
            <p>{row.text}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="band band-mist">
    <div class="container stack">
      <h2>Renovation projects</h2>
      <ul class="plain-list ruled">
        {renovationProjects.map((project) => (
          <li><a href={`/projects/${project.slug}/`}>{project.name}</a></li>
        ))}
      </ul>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <p class="measure">A renovation budget is built the same way as a new house: plans, then an estimate, then the work. <a href="/custom-homes/">How a budget gets built</a>.</p>
    </div>
  </section>
  <CloseBand href="/contact/?work=renovation" />
</Base>
