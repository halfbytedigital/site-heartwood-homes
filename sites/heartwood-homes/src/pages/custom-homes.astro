---
import { Image } from "astro:assets";
import Base from "../layouts/Base.astro";
import { customProjects, getProject, projectPath } from "../data/projects";
import ProjectIndex from "../components/ProjectIndex.astro";
import CloseBand from "../components/CloseBand.astro";
import AskProof from "../components/AskProof.astro";
import PathPicker from "../components/PathPicker.astro";
import landYes from "../assets/icons/land-yes.svg?raw";
import landLooking from "../assets/icons/land-looking.svg?raw";
import landUnsure from "../assets/icons/land-unsure.svg?raw";
import LineIcon from "../components/LineIcon.astro";
import lot from "../assets/projects/flat-top-mountain/03-DJI_0960.jpg";
import trench from "../assets/projects/flat-top-mountain/05-IMG_0296.jpg";
import footings from "../assets/projects/flat-top-mountain/04-IMG_0263.jpg";
import frame from "../assets/projects/flat-top-mountain/08-DJI_0080-HDR.jpg";
import finish from "../assets/projects/flat-top-mountain/13-IMG_7525-HDR.jpg";
import hardwood from "../assets/projects/a-frame-cabin-airbnb/06-Window-Rock-A-frame-11.jpg";
import phaseFinish from "../assets/projects/flat-top-mountain/11-DJI_0205-HDR.jpg";

const house = getProject("ten-mile-lake-house");
const flatTop = getProject("flat-top-mountain");

const trades = [
  {
    icon: "clearing",
    name: "Land clearing",
    why: "The lot is cleared before the house is laid out.",
    image: lot,
    alt: "Flat Top Mountain, the lot opened up.",
  },
  {
    icon: "trench",
    name: "Excavation",
    why: "The ground is opened up for the footings.",
    image: trench,
    alt: "A footing trench at Flat Top Mountain.",
  },
  {
    icon: "footings",
    name: "Sitework and footings",
    why: "The house sits on footings the crew pours.",
    image: footings,
    alt: "The foundation pour at Flat Top Mountain.",
  },
  {
    icon: "framing",
    name: "Framing",
    why: "The crew frames the house.",
    image: frame,
    alt: "The frame at Flat Top Mountain, with the roof started.",
  },
  {
    icon: "hardwood",
    name: "Hardwood",
    why: "Wood floors go in with the same crew.",
    image: hardwood,
    alt: "Living room in the A-frame, with wood floors.",
  },
  {
    icon: "carpentry",
    name: "Finish carpentry",
    why: "Trim and the last of the woodwork, done in house.",
    image: finish,
    alt: "Finish work inside the Flat Top Mountain house.",
  },
];

const beats = [
  {
    icon: "dream",
    name: "Dream",
    text: "The first conversation, and the plans.",
    href: "/our-process/#after-you-reach-out",
  },
  {
    icon: "build",
    name: "Build",
    text: "From the lot to the closed-in house.",
    href: "/our-process/#the-build",
  },
  {
    icon: "move",
    name: "Move-in",
    text: "A walkthrough, the drawings, and a warranty.",
    href: "/our-process/#after-you-move-in",
  },
];

const phases = [
  { image: lot, alt: "Flat Top Mountain, the lot." },
  { image: footings, alt: "Flat Top Mountain, the foundation." },
  { image: frame, alt: "Flat Top Mountain, the frame." },
  { image: phaseFinish, alt: "Flat Top Mountain, the house closed in." },
];

const questions = [
  {
    q: "How does design-build work?",
    a: "We work with you, and with your architect and engineer when you have them. Some houses are design-build. Some start from plans you already have. Both are welcome.",
  },
  {
    q: "What do you do yourselves?",
    a: "Land clearing, excavation, sitework and footings, framing, hardwood, and finish carpentry. Heartwood is also a licensed septic installer.",
  },
  {
    q: "When does the budget come?",
    a: "The budget comes after the plans. The estimate is built from those plans. Then we build.",
  },
  {
    q: "What happens after I reach out?",
    a: "A few questions first. Then we'll call or write you back.",
  },
];
---

<Base
  title="Custom Home Builder in Chattanooga | Heartwood Homes"
  description="Heartwood Homes builds custom homes in Chattanooga, with the owners and their architect, from the plans to the finished house."
>
  <section class="hero-full" data-hero>
    {house && (
      <Image
        src={house.image}
        alt={house.imageAlt}
        widths={[960, 1400, 2000]}
        sizes="100vw"
        loading="eager"
        fetchpriority="high"
      />
    )}
    <div class="container hero-full-copy">
      <div class="hero-panel">
        <div class="stack">
          <h1 data-hero-step>Forever homes should be built to last.</h1>
          <p class="lede" data-hero-step>
            We're here for the long haul. From the ground up, we build the house
            you'll live in for years.
          </p>
          {house?.credit && <p class="muted">{house.credit}</p>}
        </div>
        <div class="stack" data-hero-step>
          <a class="btn" href="/plan/" data-start-cta><span data-start-cta-label>Plan your home</span></a>
          <a class="btn btn-ghost" href="/projects/" data-see-work>See our work</a>
          <AskProof />
        </div>
      </div>
    </div>
  </section>

  <PathPicker />

  <section class="section band-mist">
    <div class="container stack">
      <h2>Your vision. Our expertise.</h2>
      <div class="trade-grid">
        {trades.map((trade) => (
          <button class="trade-card" type="button" aria-pressed="false">
            <span class="trade-face">
              <span class="trade-photo">
                <Image
                  src={trade.image}
                  alt={trade.alt}
                  widths={[480, 800]}
                  sizes="(min-width: 800px) 400px, 100vw"
                />
                <span class="trade-why">{trade.why}</span>
              </span>
              <span class="trade-name">
                <LineIcon name={trade.icon} />
                {trade.name}
              </span>
            </span>
          </button>
        ))}
      </div>
      <p class="measure">
        Heartwood is also a licensed septic installer. Learn more{" "}
        <a href="/site-prep-landwork/">here</a>.
      </p>
    </div>
  </section>

  <section class="section">
    <div class="container stack">
      <h2>Dream, build, move in</h2>
      <div class="beat-row">
        {beats.map((beat) => (
          <a class="beat" href={beat.href}>
            <LineIcon name={beat.icon} />
            <span class="beat-name">{beat.name}</span>
            <span>{beat.text}</span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <section class="section plan-teaser" aria-labelledby="teaser-title">
    <div class="container">
      <div class="teaser-frame">
        <div class="teaser-copy">
          <p class="label">Plan your home</p>
          <h2 id="teaser-title">Do you have land?</h2>
          <p class="measure">If you don’t have land yet, that’s fine. Pick one and the plan opens with it already answered.</p>
        </div>
        <ul class="land-cards" role="list">
          <li>
            <a class="land-card" href="/plan/?land=yes&amp;step=place">
              <Fragment set:html={landYes} />
              <span class="land-card-title">I have land.</span>
              <span class="land-card-note">A lot you own, or one under contract.</span>
            </a>
          </li>
          <li>
            <a class="land-card" href="/plan/?land=no&amp;step=type">
              <Fragment set:html={landLooking} />
              <span class="land-card-title">Still looking.</span>
              <span class="land-card-note">Come back when you find a spot, or talk to us now. Daniel can often walk a lot with you before you buy.</span>
            </a>
          </li>
          <li>
            <a class="land-card" href="/plan/?land=unsure&amp;step=type">
              <Fragment set:html={landUnsure} />
              <span class="land-card-title">I’m not sure.</span>
              <span class="land-card-note">We can start either way.</span>
            </a>
          </li>
        </ul>
        <p class="talk-exit"><a href="/contact/?work=custom-home">Rather just talk? Contact Heartwood</a></p>
      </div>
    </div>
  </section>

  <ProjectIndex projects={customProjects} title="Houses we've built" />

  {flatTop && (
    <section class="section band-mist">
      <div class="container stack">
        <h2>One house, from the lot</h2>
        <div class="phase-row">
          {phases.map((phase) => (
            <a href={projectPath(flatTop.slug)}>
              <Image
                src={phase.image}
                alt={phase.alt}
                widths={[480, 800]}
                sizes="(min-width: 800px) 280px, 70vw"
              />
            </a>
          ))}
        </div>
        <p>
          <a class="text-link" href={projectPath(flatTop.slug)}>
            Flat Top Mountain
          </a>
        </p>
        {flatTop.credit && <p class="muted">{flatTop.credit}</p>}
      </div>
    </section>
  )}

  <section class="section">
    <div class="container stack">
      <h2>Plans, then an estimate, then we build.</h2>
      <p class="measure">
        The budget comes after the plans. The estimate is built from those
        plans.
      </p>
    </div>
  </section>

  <section class="section band-mist">
    <div class="container">
      <h2>Questions we hear</h2>
      <div class="faq">
        {questions.map((item) => (
          <details>
            <summary>{item.q}</summary>
            <p>{item.a}</p>
          </details>
        ))}
      </div>
    </div>
  </section>

  <CloseBand
    href="/plan/"
    title="When you want to talk."
    line="Plans, then an estimate, then we build."
    label="Plan your home"
  />
</Base>

<script>
  document
    .querySelectorAll<HTMLButtonElement>(".trade-card")
    .forEach((card) => {
      card.addEventListener("click", () => {
        const next = card.getAttribute("aria-pressed") !== "true";
        card.setAttribute("aria-pressed", String(next));
      });
    });
</script>
