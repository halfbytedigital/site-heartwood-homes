---
import { getImage } from 'astro:assets';
import Base from '../layouts/Base.astro';
import { site } from '../data/site';
import { customProjects, getProject } from '../data/projects';
import { inHouseTrades, budgetSteps } from '../data/services';
import Button from '../components/Button.astro';
import ProjectIndex from '../components/ProjectIndex.astro';
import CloseBand from '../components/CloseBand.astro';
import AskProof from '../components/AskProof.astro';

const photo = getProject('hixson-new-build');
const heroMobile = photo ? await getImage({ src: photo.image, width: 720, quality: 64 }) : null;
const heroDesktop = photo ? await getImage({ src: photo.image, width: 1400, quality: 70 }) : null;
---
<Base
  title="Custom Home Builder in Chattanooga | Heartwood Homes"
  description="Heartwood Homes builds custom homes in Chattanooga, with the owners and their architect, from the plans to the finished house."
>
  <section class="edge-split">
    <div class="edge-copy">
      <h1>The house you plan to stay in.</h1>
      <p class="lede">A new home from the ground up, with the owners, the architect, and the engineer.</p>
      <div class="btn-row">
        <Button href="/contact/?work=custom-home">Start your home</Button>
        {site.phone && site.phoneE164 && <Button href={`tel:${site.phoneE164}`} variant="ghost">{site.phone}</Button>}
      </div>
      <AskProof />
    </div>
    {photo && (
      <figure class="bleed-photo">
        <picture>
          <source media="(min-width: 800px)" srcset={heroDesktop?.src} />
          <img src={heroMobile?.src} alt={photo.imageAlt} width={heroMobile?.attributes.width} height={heroMobile?.attributes.height} loading="eager" fetchpriority="high" decoding="async" />
        </picture>
        {photo.credit && <figcaption>{photo.credit}</figcaption>}
      </figure>
    )}
  </section>

  <section class="band">
    <div class="container stack">
      <h2>Design-build, or your plans.</h2>
      <p class="measure">Heartwood works with owners, architects, and engineers. Some houses are design-build. Some start from plans that already exist. Both are welcome.</p>
      <p class="measure">The budget comes after the plans. This page does not list a price.</p>
    </div>
  </section>

  <section class="band band-mist">
    <div class="container">
      <h2>In the house</h2>
      <p class="measure">These are the trades the crew keeps in house.</p>
      <ol class="numeral-list ruled">
        {inHouseTrades.map((trade, index) => (
          <li>
            <span class="numeral">{String(index + 1).padStart(2, '0')}</span>
            <span>{trade}</span>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <ProjectIndex projects={customProjects} title="New houses" />

  <section class="band">
    <div class="container">
      <h2>How a budget gets built</h2>
      <ol class="numeral-list">
        {budgetSteps.map((step, index) => (
          <li>
            <span class="numeral">{index + 1}</span>
            <div>
              <h3>{step.title}</h3>
              <p>{step.text}</p>
            </div>
          </li>
        ))}
      </ol>
      <p><a class="text-link" href="/our-process/">The rest of the process</a></p>
    </div>
  </section>

  <CloseBand href="/contact/?work=custom-home" line="Plans, then an estimate, then the build. A few questions come first. Then Heartwood calls or writes you back." />
</Base>
