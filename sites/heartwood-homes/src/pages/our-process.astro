---
import Base from '../layouts/Base.astro';
import { processSteps } from '../data/services';
import CloseBand from '../components/CloseBand.astro';
---
<Base
  title="Our Building Process | Heartwood Homes"
  description="How a Heartwood Homes custom build runs, from the first conversation through plans, estimate, construction, and walkthrough."
>
  <section class="section">
    <div class="container stack">
      <h1>From the first conversation to the walkthrough.</h1>
      <p class="lede">This is the path for a new house.</p>
    </div>
  </section>

  <section class="band edge-rule">
    <div class="container">
      <ol class="numeral-list">
        {processSteps.map((step, index) => (
          <li>
            <span class="numeral">{String(index + 1).padStart(2, '0')}</span>
            <div>
              <h2>{step.title}</h2>
              <p class="measure">{step.text}</p>
            </div>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <section class="band band-mist">
    <div class="container">
      <h2>What Heartwood already lists</h2>
      <div class="ruled">
        <article><h3>Pre-construction</h3><p>Design-build, scheduling, estimating, and budgeting.</p></article>
        <article><h3>Construction</h3><p>An in-house team, quality control, safety, and subcontractor management.</p></article>
        <article><h3>After construction</h3><p>Certificate of occupancy and as-built drawings.</p></article>
        <article><h3>Warranty</h3><p>Named at the end of the job.</p></article>
      </div>
    </div>
  </section>

  <CloseBand href="/contact/?work=custom-home" title="When you are ready." line="Start with a conversation. A few questions come first, then Heartwood calls or writes you back." />
</Base>
