---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import { site } from '../data/site';
import { getProject, customProjects } from '../data/projects';
import { planHref, planLabel } from '../data/nav';
import AskProof from '../components/AskProof.astro';
import TrustStrip from '../components/TrustStrip.astro';
import FeaturedHome from '../components/FeaturedHome.astro';
import ProjectIndex from '../components/ProjectIndex.astro';
import BuildScrubber from '../components/signature/BuildScrubber.astro';
import CloseBand from '../components/CloseBand.astro';

const house = getProject('a-frame-cabin-airbnb');
const founders = site.team?.map((person) => person.name).join(' and ');
---
<Base
  title="Custom Homes in Chattanooga, TN | Heartwood Homes"
  description="Heartwood Homes builds custom homes in Chattanooga. A family company, from the first plans to the finished house."
>
  <section class="hero-full" data-hero>
    {house && (
      <Image
        src={house.image}
        alt={house.imageAlt}
        widths={[960, 1400, 2000]}
        sizes="100vw"
        loading="eager"
        fetchpriority="high"
      />
    )}
    <div class="container hero-full-copy">
      <div class="hero-panel">
        <div class="stack">
          <h1 data-hero-step>A custom home,<br><span class="hero-line">built for your family.</span></h1>
          <p class="lede" data-hero-step>We build the house with you, and we stay through the last piece of trim.</p>
          {house?.credit && <p class="muted">{house.credit}</p>}
        </div>
        <div class="stack" data-hero-step>
          <a class="btn" href={planHref} data-start-cta><span data-start-cta-label>{planLabel}</span></a>
          <a class="btn btn-ghost" href="/projects/" data-see-work>See our work</a>
          <AskProof />
        </div>
      </div>
    </div>
  </section>

  <TrustStrip />
  <FeaturedHome />
  <BuildScrubber />
  <ProjectIndex projects={customProjects} title="Homes we've built" />

  <section class="section">
    <div class="container stack">
      <h2>We start with the land, too.</h2>
      <div class="measure stack">
        <p>Site prep before the build. Grading and landscaping after. Site prep is part of the build. We also take on renovations.</p>
        <p>Land clearing, excavation, sitework, and footings, with Heartwood’s own machines.</p>
        <a class="text-link" href="/site-prep-landwork/">Site prep and landwork</a>
        <a class="text-link" href="/renovations/">Renovations</a>
      </div>
    </div>
  </section>

  <section class="section band-mist">
    <div class="container stack">
      <h2>A family company.</h2>
      <div class="letter measure">
        {founders && site.yearFounded && <p>{founders} founded {site.legalName ?? site.name} in {site.yearFounded}.</p>}
        <p>We are a Chattanooga-based, family-owned company built on Christian values. We work with a family from the first conversation through the last piece of trim, and we tell you straight.</p>
        <p>Daniel and his crew would love to work with you and your family on the home construction you need.</p>
        {founders && <p class="sign">{founders}</p>}
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container stack">
      <h2>What a build involves</h2>
      <p class="measure">Plans, then an estimate, then we build. If you want to talk numbers, call us.</p>
      <a class="text-link" href="/our-process/">How a Heartwood build runs</a>
    </div>
  </section>

  <CloseBand />
</Base>
