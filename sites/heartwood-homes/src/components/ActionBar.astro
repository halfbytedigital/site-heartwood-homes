---
import { site } from '../data/site';
import { planHref, planLabel } from '../data/nav';
const path = Astro.url.pathname;
const quotePage = path.startsWith('/contact');
const planPage = path.startsWith('/plan');
const bar = path.startsWith('/renovations')
  ? { href: '/contact/?work=renovation', label: 'Tell us about it', start: false }
  : path.startsWith('/site-prep')
    ? { href: '/contact/?work=site-prep', label: 'Tell us about it', start: false }
    : { href: planHref, label: planLabel, start: true };
---
{!quotePage && !planPage && (
  <nav class="action-bar" aria-label="Quick actions">
    {site.phone && site.phoneE164 && (
      <a href={`tel:${site.phoneE164}`} data-event="call_click" data-event-placement="bar">Call</a>
    )}
    {bar.start ? (
      <a href={bar.href} data-start-cta><span data-start-cta-label>{bar.label}</span></a>
    ) : (
      <a href={bar.href}>{bar.label}</a>
    )}
  </nav>
)}

<script>
  const bar = document.querySelector('.action-bar');
  if (bar) {
    const root = document.documentElement;
    const onFocus = (event: Event) => {
      const target = event.target;
      if (!(target instanceof HTMLElement)) return;
      const typing = target.matches('input, textarea, select');
      root.classList.toggle('keyboard-open', typing);
    };
    document.addEventListener('focusin', onFocus);
    document.addEventListener('focusout', () => {
      window.setTimeout(() => {
        const active = document.activeElement;
        const typing = active instanceof HTMLElement && active.matches('input, textarea, select');
        root.classList.toggle('keyboard-open', typing);
      }, 0);
    });
  }
</script>
