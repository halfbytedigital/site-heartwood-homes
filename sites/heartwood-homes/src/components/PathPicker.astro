---
import newHome from '../assets/icons/path-new-home.svg?raw';
import renovate from '../assets/icons/path-renovate.svg?raw';
import lotReady from '../assets/icons/path-lot-ready.svg?raw';
---
<section class="section" aria-labelledby="path-title">
  <div class="container stack">
    <h2 id="path-title">What are you looking to do?</h2>
    <ul class="path-cards" role="list">
      <li>
        <a class="path-card" href="/plan/">
          <Fragment set:html={newHome} />
          <span class="path-card-title">Build a new home</span>
          <span class="path-card-note">A few easy questions, then a brief and a sketch of the house.</span>
          <span class="path-card-go">Plan your home<span aria-hidden="true"> →</span></span>
        </a>
      </li>
      <li>
        <a class="path-card" href="/contact/?work=renovation">
          <Fragment set:html={renovate} />
          <span class="path-card-title">Renovate or add on</span>
          <span class="path-card-note">A short form about the house and what you want to change.</span>
          <span class="path-card-go">Tell us about it<span aria-hidden="true"> →</span></span>
        </a>
      </li>
      <li>
        <a class="path-card" href="/contact/?work=site-prep">
          <Fragment set:html={lotReady} />
          <span class="path-card-title">Get a lot ready</span>
          <span class="path-card-note">Clearing, grading, a drive, a pad.</span>
          <span class="path-card-go">Tell us about it<span aria-hidden="true"> →</span></span>
        </a>
      </li>
    </ul>
  </div>
</section>
