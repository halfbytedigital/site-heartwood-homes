---
interface Props {
  href?: string;
  type?: 'button' | 'submit';
  variant?: 'primary' | 'ghost';
}
const { href, type = 'button', variant = 'primary' } = Astro.props;
const cls = variant === 'ghost' ? 'btn btn-ghost' : 'btn';
---
{href ? <a class={cls} href={href}><slot /></a> : <button class={cls} type={type}><slot /></button>}
