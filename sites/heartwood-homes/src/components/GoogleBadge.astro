---
import { googleProfileHref, site } from '../data/site';
const { rating, reviewCount, reviewUrl } = site.google;
const href = googleProfileHref(reviewUrl);
const show = rating != null && reviewCount != null;
---
{show && (
  href ? (
    <a href={href}>{rating.toFixed(1)} from {reviewCount} Google reviews</a>
  ) : (
    <p>{rating.toFixed(1)} from {reviewCount} Google reviews</p>
  )
)}
