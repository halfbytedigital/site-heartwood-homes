---
import { Image } from 'astro:assets';
import { jobFilters, projectPath, typesFor, type Project } from '../data/projects';
import SaveHouse from './SaveHouse.astro';

interface Props {
  projects: Project[];
  title?: string;
  showFilters?: boolean;
}
const { projects, title, showFilters = false } = Astro.props;
const counts = Object.fromEntries(
  jobFilters.map((filter) => [
    filter.slug,
    filter.slug === 'all'
      ? projects.length
      : projects.filter((project) => typesFor(project.slug).includes(filter.slug)).length,
  ]),
);
---
<section class:list={['section', showFilters && 'index-list-section']} data-work data-project-filters={showFilters ? '' : undefined}>
  <div class="container work">
    {title && <h2 class="work-title">{title}</h2>}
    {showFilters && (
      <div class="project-filters">
        <div class="filter-chips" role="group" aria-label="Filter projects by type">
          {jobFilters.map((filter) => (
            <button type="button" data-filter={filter.slug} aria-pressed={filter.slug === 'all' ? 'true' : 'false'}>
              {filter.label} <span class="filter-count">{counts[filter.slug]}</span>
            </button>
          ))}
        </div>
      </div>
    )}
    <ol class="work-list">
      {projects.map((project) => (
        <li class="work-item" data-types={showFilters ? typesFor(project.slug).join(' ') : undefined}>
          <a class="work-link" href={projectPath(project.slug)} data-shot={project.slug}>
            <Image src={project.image} alt="" widths={[480, 960, 1400]} sizes="(min-width: 900px) 96px, 100vw" />
            <span class="work-name">{project.name}</span>
            <span class="muted">{project.dates}</span>
          </a>
          <SaveHouse slug={project.slug} name={project.name} />
        </li>
      ))}
    </ol>
    <figure class="work-stage">
      {projects.map((project, index) => (
        <Image
          src={project.image}
          alt=""
          widths={[800, 1200, 1600]}
          sizes="(min-width: 900px) 50vw, 100vw"
          class:list={[{ 'is-on': index === 0 }]}
          data-frame={project.slug}
        />
      ))}
    </figure>
  </div>
</section>

<script>
  const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  document.querySelectorAll<HTMLElement>('[data-work]').forEach((root) => {
    const frames = [...root.querySelectorAll<HTMLImageElement>('[data-frame]')];
    const show = (slug: string) => {
      frames.forEach((frame) => frame.classList.toggle('is-on', frame.dataset.frame === slug));
    };
    root.querySelectorAll<HTMLAnchorElement>('[data-shot]').forEach((link) => {
      const slug = link.dataset.shot ?? '';
      const activate = () => show(slug);
      link.addEventListener('pointerenter', activate);
      link.addEventListener('focus', activate);
      if (reduce) link.addEventListener('focus', activate);
    });
  });
</script>
