---
import { Image } from 'astro:assets';
import { getProject } from '../../data/projects';
import AskProof from '../AskProof.astro';
import lot from '../../assets/projects/flat-top-mountain/03-DJI_0960.jpg';
import foundation from '../../assets/projects/flat-top-mountain/04-IMG_0263.jpg';
import frame from '../../assets/projects/flat-top-mountain/08-DJI_0080-HDR.jpg';
import finish from '../../assets/projects/flat-top-mountain/11-DJI_0205-HDR.jpg';

const house = getProject('flat-top-mountain');
if (!house) throw new Error('Flat Top Mountain is missing from projects.');

const chapters = [
  {
    id: 'lot',
    label: 'The lot',
    text: 'The lot opened up, with the foundation lines laid out on the dirt.',
    image: lot,
    alt: 'Flat Top Mountain, the lot opened up with foundation lines on the dirt.',
  },
  {
    id: 'foundation',
    label: 'Foundation',
    text: 'Footings and the concrete pour, before the frame.',
    image: foundation,
    alt: 'Flat Top Mountain, the foundation pour.',
  },
  {
    id: 'frame',
    label: 'Frame',
    text: 'The frame goes up. Framing is work the Heartwood crew does in house.',
    image: frame,
    alt: 'Flat Top Mountain, the frame with the roof started.',
  },
  {
    id: 'finish',
    label: 'Finish',
    text: 'The house closed in. Inside, finish work was still underway.',
    image: finish,
    alt: 'Flat Top Mountain, the house closed in.',
  },
];
---
<section class="scrub" data-scrubber data-showing="lot" aria-labelledby="scrubber-title">
  <div class="scrub-stage">
    <figure class="scrub-photo">
      {chapters.map((chapter, index) => (
        <Image
          src={chapter.image}
          alt={chapter.alt}
          widths={[960, 1400]}
          sizes="100vw"
          loading={index === 0 ? 'eager' : 'lazy'}
          class:list={[{ 'is-on': index === 0 }]}
          data-frame={chapter.id}
        />
      ))}
      {house.credit && <figcaption>{house.credit}</figcaption>}
    </figure>
    <ol class="chapters">
      {chapters.map((chapter, index) => (
        <li class:list={['chapter', { 'is-active': index === 0 }]} data-chapter={chapter.id}>
          <h3>{chapter.label}</h3>
          <p>{chapter.text}</p>
        </li>
      ))}
    </ol>
  </div>
  <div class="container scrub-panel">
    <div class="stack-s">
      <p class="muted">Flat Top Mountain</p>
      <h2 id="scrubber-title">From the lot to the finished home</h2>
    </div>
    <div class="scrub-control">
      <label for="build-scrubber">Chapter</label>
      <input
        id="build-scrubber"
        type="range"
        min="1"
        max={chapters.length}
        value={1}
        step="1"
        aria-valuemin={1}
        aria-valuemax={chapters.length}
        aria-valuenow={1}
        aria-valuetext="The lot"
      />
      <div class="ticks" aria-hidden="true">
        {chapters.map((chapter) => <span>{chapter.label}</span>)}
      </div>
    </div>
    <p class="scrubber-live visually-hidden" aria-live="polite">The lot. {chapters[0].text}</p>
    <a class="btn" href={`/contact/?project=${house.slug}&chapter=finish&work=custom-home`} data-scrubber-cta data-start-cta>
      <span data-start-cta-label>Start your home</span>
    </a>
    <AskProof />
  </div>
</section>

<script>
  const root = document.querySelector<HTMLElement>('[data-scrubber]');
  if (root) {
    root.dataset.enhanced = 'true';
    const input = root.querySelector<HTMLInputElement>('input[type="range"]');
    const live = root.querySelector<HTMLElement>('.scrubber-live');
    const cta = root.querySelector<HTMLAnchorElement>('[data-scrubber-cta]');
    const items = [...root.querySelectorAll<HTMLElement>('[data-chapter]')];
    const labels = items.map((item) => item.querySelector('h3')?.textContent?.trim() ?? '');

    const show = (index: number) => {
      items.forEach((item, i) => item.classList.toggle('is-active', i === index));
      root.querySelectorAll<HTMLImageElement>('[data-frame]').forEach((img) => {
        img.classList.toggle('is-on', img.dataset.frame === items[index]?.dataset.chapter);
      });
      const id = items[index]?.dataset.chapter ?? '';
      root.dataset.showing = id;
      const label = labels[index] ?? '';
      const text = items[index]?.querySelector('p')?.textContent?.trim() ?? '';
      if (input) {
        input.value = String(index + 1);
        input.setAttribute('aria-valuenow', String(index + 1));
        input.setAttribute('aria-valuetext', label);
      }
      if (live) live.textContent = `${label}. ${text}`;
      if (cta) {
        const url = new URL(cta.href);
        url.searchParams.set('chapter', id);
        cta.href = `${url.pathname}${url.search}`;
      }
    };

    input?.addEventListener('input', () => show(Number(input.value) - 1));
  }
</script>
