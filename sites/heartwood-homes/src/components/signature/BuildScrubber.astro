---
import { Image } from 'astro:assets';
import { getProject } from '../../data/projects';
import lot from '../../assets/projects/flat-top-mountain/03-DJI_0960.jpg';
import foundation from '../../assets/projects/flat-top-mountain/04-IMG_0263.jpg';
import frame from '../../assets/projects/flat-top-mountain/08-DJI_0080-HDR.jpg';
import finish from '../../assets/projects/flat-top-mountain/11-DJI_0205-HDR.jpg';

const house = getProject('flat-top-mountain');
if (!house) throw new Error('Flat Top Mountain is missing from projects.');

const chapters = [
  {
    id: 'lot',
    label: 'The lot',
    text: 'The lot opened up, with the foundation lines laid out on the dirt.',
    image: lot,
    alt: 'Flat Top Mountain, the lot opened up with foundation lines on the dirt.',
  },
  {
    id: 'foundation',
    label: 'Foundation',
    text: 'Footings and the concrete pour, before the frame.',
    image: foundation,
    alt: 'Flat Top Mountain, the foundation pour.',
  },
  {
    id: 'frame',
    label: 'Frame',
    text: 'The frame goes up. Framing is work the Heartwood crew does in house.',
    image: frame,
    alt: 'Flat Top Mountain, the frame with the roof started.',
  },
  {
    id: 'finish',
    label: 'Finish',
    text: 'The house closed in. Inside, finish work was still underway.',
    image: finish,
    alt: 'Flat Top Mountain, the house closed in.',
  },
];

const pad = (n: number) => String(n).padStart(2, '0');
---
<section class="scrub" data-scrubber data-showing="lot" aria-labelledby="scrubber-title">
  <div class="scrub-fit">
    <figure class="scrub-photo" tabindex="0" aria-label="Drag across the photo to move through the build">
      {chapters.map((chapter, index) => (
        <Image
          src={chapter.image}
          alt={chapter.alt}
          widths={[960, 1400, 2000]}
          sizes="100vw"
          loading={index === 0 ? 'eager' : 'lazy'}
          class:list={[{ 'is-on': index === 0 }]}
          data-frame={chapter.id}
          draggable="false"
        />
      ))}
      {house.credit && <figcaption class="scrub-credit">{house.credit}</figcaption>}
      <div class="scrub-glass">
        <p class="scrub-kicker">Flat Top Mountain</p>
        <h2 id="scrubber-title">From the lot to the finished home</h2>
        <p class="scrub-readout" data-scrub-readout>{pad(1)} / {pad(chapters.length)} {chapters[0].label}</p>
        <p class="scrub-caption" data-scrub-caption>{chapters[0].text}</p>
        <div class="tape">
          <div class="tape-rule" aria-hidden="true">
            {chapters.map((_, index) => <span class="tape-tick" style={`--i: ${index}`}></span>)}
            <span class="tape-fill" data-tape-fill></span>
            <span class="tape-handle" data-tape-handle></span>
          </div>
          <div class="tape-stops">
            {chapters.map((chapter, index) => (
              <button type="button" data-stop={index} data-text={chapter.text} style={`--i: ${index}`} aria-pressed={index === 0 ? 'true' : 'false'}>{chapter.label}</button>
            ))}
          </div>
          <label class="visually-hidden" for="build-scrubber">Chapter</label>
          <input
            id="build-scrubber"
            class="tape-range"
            type="range"
            min="1"
            max={chapters.length}
            value={1}
            step="1"
            aria-valuemin={1}
            aria-valuemax={chapters.length}
            aria-valuenow={1}
            aria-valuetext="The lot"
          />
        </div>
        <a class="scrub-quiet" href="/plan/" data-scrub-quiet>Plan your home</a>
        <a class="btn scrub-cta" href="/plan/" data-scrubber-cta data-start-cta>
          <span data-start-cta-label>Plan your home</span>
        </a>
      </div>
    </figure>
    <div class="scrub-cta-slot">
      <a class="btn scrub-cta" href="/plan/" data-scrubber-cta data-start-cta>
        <span data-start-cta-label>Plan your home</span>
      </a>
    </div>
  </div>
  <p class="scrubber-live visually-hidden" aria-live="polite">The lot. {chapters[0].text}</p>
</section>

<script>
  const root = document.querySelector<HTMLElement>('[data-scrubber]');
  if (root) {
    const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    const input = root.querySelector<HTMLInputElement>('input[type="range"]');
    const live = root.querySelector<HTMLElement>('.scrubber-live');
    const readout = root.querySelector<HTMLElement>('[data-scrub-readout]');
    const caption = root.querySelector<HTMLElement>('[data-scrub-caption]');
    const fill = root.querySelector<HTMLElement>('[data-tape-fill]');
    const handle = root.querySelector<HTMLElement>('[data-tape-handle]');
    const stops = [...root.querySelectorAll<HTMLButtonElement>('[data-stop]')];
    const frames = [...root.querySelectorAll<HTMLImageElement>('[data-frame]')];
    const ctas = [...root.querySelectorAll<HTMLAnchorElement>('[data-scrubber-cta], [data-scrub-quiet]')];
    const labels = stops.map((stop) => stop.textContent?.trim() ?? '');
    const lines = stops.map((stop) => stop.dataset.text ?? '');
    const ids = frames.map((img) => img.dataset.frame ?? '');
    const count = stops.length;
    let index = 0;

    const roll = (el: HTMLElement | null) => {
      if (!el || reduced) return;
      el.classList.remove('is-rolling');
      void el.offsetWidth;
      el.classList.add('is-rolling');
    };

    const show = (next: number, animate = true) => {
      index = Math.max(0, Math.min(count - 1, next));
      const id = ids[index] ?? '';
      const label = labels[index] ?? '';
      root.dataset.showing = id;
      root.classList.toggle('is-finish', id === 'finish');
      frames.forEach((img) => img.classList.toggle('is-on', img.dataset.frame === id));
      stops.forEach((stop, i) => stop.setAttribute('aria-pressed', String(i === index)));
      place(index);
      if (input) {
        input.value = String(index + 1);
        input.setAttribute('aria-valuenow', String(index + 1));
        input.setAttribute('aria-valuetext', label);
      }
      if (readout) {
        readout.textContent = `${String(index + 1).padStart(2, '0')} / ${String(count).padStart(2, '0')} ${label}`;
        if (animate) roll(readout);
      }
      if (caption) {
        caption.textContent = lines[index] ?? '';
        if (animate) roll(caption);
      }
      if (live) live.textContent = `${label}. ${lines[index] ?? ''}`;
      ctas.forEach((cta) => { cta.href = '/plan/'; });
    };

    const place = (progress: number) => {
      const t = count <= 1 ? 0 : Math.max(0, Math.min(count - 1, progress)) / (count - 1);
      const left = `calc(var(--thumb) / 2 + (100% - var(--thumb)) * ${t})`;
      if (handle) handle.style.left = left;
      if (fill) fill.style.width = `calc((100% - var(--thumb)) * ${t})`;
    };

    show(0, false);

    input?.addEventListener('input', () => show(Number(input.value) - 1));
    stops.forEach((stop) => stop.addEventListener('click', () => show(Number(stop.dataset.stop))));

    const photo = root.querySelector<HTMLElement>('.scrub-photo');
    let startX = 0;
    let lastX = 0;
    let startIndex = 0;
    let tracking = false;
    const along = (clientX: number) => {
      const width = photo?.getBoundingClientRect().width || 1;
      return startIndex + (startX - clientX) / (width / count);
    };
    const trackDrag = (on: boolean) => {
      const value = on ? 'none' : '';
      if (handle) handle.style.transition = value;
      if (fill) fill.style.transition = value;
    };
    const fromPhoto = (event: Event) => {
      const target = event.target as HTMLElement | null;
      return !!target && !target.closest('.scrub-glass, a, button, input');
    };
    photo?.addEventListener('dragstart', (event) => event.preventDefault());
    photo?.querySelectorAll('img').forEach((img) => { img.draggable = false; });
    photo?.addEventListener('pointerdown', (event) => {
      if (!fromPhoto(event) || event.button > 0) return;
      startX = lastX = event.clientX;
      startIndex = index;
      tracking = true;
      trackDrag(true);
    });
    photo?.addEventListener('pointermove', (event) => {
      if (!tracking) return;
      lastX = event.clientX;
      place(along(event.clientX));
    });
    const finishDrag = (clientX: number) => {
      if (!tracking || !photo) return;
      tracking = false;
      trackDrag(false);
      const delta = clientX - startX;
      if (Math.abs(delta) < 24) {
        show(startIndex, false);
        return;
      }
      show(Math.round(along(clientX)));
    };
    window.addEventListener('pointerup', (event) => finishDrag(event.clientX));
    photo?.addEventListener('pointercancel', () => finishDrag(lastX));

    const onKey = (event: KeyboardEvent) => {
      const target = event.target as HTMLElement | null;
      if (!target || target.closest('a, button')) return;
      const onSlider = target === input;
      const onStage = target === photo || (!!photo && photo.contains(target) && !target.closest('.scrub-glass'));
      if (!onStage && !onSlider) return;
      if (event.key !== 'ArrowRight' && event.key !== 'ArrowLeft') return;
      if (onSlider) return;
      event.preventDefault();
      show(event.key === 'ArrowRight' ? index + 1 : index - 1);
    };
    root.addEventListener('keydown', onKey);
  }
</script>
