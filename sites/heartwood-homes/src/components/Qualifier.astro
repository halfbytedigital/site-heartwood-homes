---
import { site } from '../data/site';
import { ctaLabel } from '../data/nav';
import AskProof from './AskProof.astro';

const params = Astro.url.searchParams;
const work = params.get('work') ?? '';
const project = params.get('project') ?? '';
const chapter = params.get('chapter') ?? '';
const path = params.get('path') ?? '';
const rawLand = params.get('land') ?? (path === 'have-land' ? 'Yes' : path === 'find-land' ? 'Still looking' : '');
const landKey = rawLand.toLowerCase();
const landChoice = landKey === 'not yet' || landKey === 'find-land' || landKey === 'still looking' || landKey === 'no'
  ? 'Still looking'
  : landKey === 'yes' || landKey === 'have-land'
    ? 'Yes'
    : landKey === 'not sure' || landKey === 'unsure' || landKey === 'not-sure'
      ? 'Not sure'
      : rawLand;
const timelineChoice = params.get('timeline') ?? (path === 'dreaming' ? 'Just looking' : '');
---
<form class="qualifier" method="post" action="/api/quote" data-qualifier novalidate>
  <div class="carried" data-carried hidden></div>
  <p data-plan-return hidden><a href="/plan/">Back to your brief</a></p>
  <p data-progress>Step 1 of 5</p>
  <div class="step" data-step="0">
    <h2>What are you planning?</h2>
    <div class="choice-list">
      <label class="choice"><input type="radio" name="work" value="custom-home" checked={work === 'custom-home'} /> Custom home</label>
      <label class="choice"><input type="radio" name="work" value="renovation" checked={work === 'renovation'} /> Renovation</label>
      <label class="choice"><input type="radio" name="work" value="site-prep" checked={work === 'site-prep'} /> Site prep and landwork</label>
    </div>
  </div>
  <div class="step" data-step="1">
    <h2>Where should we build?</h2>
    <div class="choice-list">
      <label class="choice"><input type="radio" name="area" value="Chattanooga area" /> Chattanooga area</label>
      <label class="choice"><input type="radio" name="area" value="Somewhere else" /> Somewhere else</label>
    </div>
    <label class="field">
      Town or area, if you want to say
      <input name="area-note" autocomplete="address-level2" />
    </label>
  </div>
  <div class="step" data-step="2">
    <h2>Do you have land?</h2>
    <div class="choice-list">
      <label class="choice"><input type="radio" name="land" value="Yes" checked={landChoice === 'Yes'} /> Yes</label>
      <label class="choice"><input type="radio" name="land" value="Still looking" checked={landChoice === 'Still looking'} /> Still looking</label>
      <label class="choice"><input type="radio" name="land" value="Not sure" checked={landChoice === 'Not sure'} /> Not sure</label>
    </div>
  </div>
  <div class="step" data-step="3">
    <h2>When are you hoping to start?</h2>
    <div class="choice-list">
      <label class="choice"><input type="radio" name="timeline" value="Ready to start" checked={timelineChoice === 'Ready to start'} /> Ready to start</label>
      <label class="choice"><input type="radio" name="timeline" value="This year" checked={timelineChoice === 'This year'} /> This year</label>
      <label class="choice"><input type="radio" name="timeline" value="Just looking" checked={timelineChoice === 'Just looking'} /> Just looking</label>
    </div>
  </div>
  <div class="step" data-step="4">
    <h2>How should we reach you?</h2>
    <label class="field">
      Name
      <input name="name" autocomplete="name" />
    </label>
    <label class="field">
      Phone
      <input name="phone" type="tel" autocomplete="tel" inputmode="tel" />
    </label>
    <label class="field">
      Email
      <input name="email" type="email" autocomplete="email" />
    </label>
    <p class="muted">A phone number or an email is enough. We'll talk through the budget once we know the house.</p>
    <label class="field">
      Houses you liked
      <input name="houses" data-saved-houses-field readonly />
    </label>
  </div>
  <p class="visually-hidden">
    <label>Company<input class="visually-hidden" name="company" tabindex="-1" autocomplete="off" /></label>
  </p>
  {project && <input type="hidden" name="project" value={project} />}
  {chapter && <input type="hidden" name="chapter" value={chapter} />}
  <input type="hidden" name="path" value={path} />
  <div class="btn-row">
    <button class="btn btn-ghost" type="button" data-back hidden>Back</button>
    <button class="btn" type="button" data-next>Continue</button>
    <button class="btn" type="submit" data-submit data-start-cta><span data-start-cta-label>{ctaLabel}</span></button>
  </div>
  <AskProof />
  <p class="form-status" data-status hidden></p>
  {site.phone && site.phoneE164 && (
    <p class="muted">Or call <a href={`tel:${site.phoneE164}`} data-event="call_click" data-event-placement="form">{site.phone}</a>.</p>
  )}
</form>

<script>
  import { track } from '../scripts/analytics';

  const form = document.querySelector<HTMLFormElement>('[data-qualifier]');
  if (form) {
    const params = new URLSearchParams(location.search);
    const pathValue = params.get('path') ?? '';
    const rawLand = params.get('land') ?? (pathValue === 'have-land' ? 'Yes' : pathValue === 'find-land' ? 'Still looking' : '');
    const landKey = rawLand.toLowerCase();
    const landValue = landKey === 'not yet' || landKey === 'find-land' || landKey === 'still looking' || landKey === 'no'
      ? 'Still looking'
      : landKey === 'yes' || landKey === 'have-land'
        ? 'Yes'
        : landKey === 'not sure' || landKey === 'unsure' || landKey === 'not-sure'
          ? 'Not sure'
          : rawLand;
    const timelineValue = params.get('timeline') ?? (pathValue === 'dreaming' ? 'Just looking' : '');

    const setRadio = (name: string, value: string) => {
      form.querySelectorAll<HTMLInputElement>(`input[type="radio"][name="${name}"]`).forEach((radio) => {
        radio.checked = value !== '' && radio.value === value;
      });
    };
    const setHidden = (name: string, value: string) => {
      let field = form.querySelector<HTMLInputElement>(`input[type="hidden"][name="${name}"]`);
      if (!field) {
        field = document.createElement('input');
        field.type = 'hidden';
        field.name = name;
        form.append(field);
      }
      field.value = value;
    };

    setRadio('work', params.get('work') ?? '');
    setRadio('land', landValue);
    setRadio('timeline', timelineValue);
    setHidden('path', pathValue);
    setHidden('project', params.get('project') ?? '');
    setHidden('chapter', params.get('chapter') ?? '');
    if (params.get('from') === 'plan') {
      const said = params.get('said') ?? '';
      const carried = form.querySelector<HTMLElement>('[data-carried]');
      if (carried && said) {
        carried.hidden = false;
        const intro = document.createElement('p');
        intro.textContent = 'What you’ve already told us:';
        const list = document.createElement('ul');
        said.split(' · ').filter(Boolean).forEach((line) => {
          const item = document.createElement('li');
          item.textContent = line;
          list.append(item);
        });
        carried.append(intro, list);
        setHidden('message', said);
      }
      const back = form.querySelector<HTMLElement>('[data-plan-return]');
      const link = back?.querySelector<HTMLAnchorElement>('a');
      if (back && link) {
        back.hidden = false;
        const backParams = new URLSearchParams(params);
        backParams.delete('from');
        backParams.delete('said');
        const step = backParams.get('step') || 'land';
        backParams.delete('step');
        link.href = `/plan/?${backParams.toString()}#${step}`;
      }
      const place = params.get('place') ?? '';
      const note = form.querySelector<HTMLInputElement>('input[name="area-note"]');
      if (place && note && !note.value) note.value = place;
      ['place', 'acres', 'terrain', 'cover', 'access', 'power', 'water', 'sewer', 'internet', 'structure', 'type', 'beds', 'baths', 'stories', 'sqft', 'who', 'use', 'plans', 'needs', 'budget', 'pay', 'sell', 'survey', 'timing'].forEach((key) => {
        const value = params.get(key);
        if (value) setHidden(key, value);
      });
      if ((params.get('timeline') ?? '') === 'Next year') setHidden('timeline', 'Next year');
    }
    const steps = [...form.querySelectorAll<HTMLElement>('[data-step]')];
    const progress = form.querySelector<HTMLElement>('[data-progress]');
    const status = form.querySelector<HTMLElement>('[data-status]');
    const next = form.querySelector<HTMLButtonElement>('[data-next]');
    const back = form.querySelector<HTMLButtonElement>('[data-back]');
    const submit = form.querySelector<HTMLButtonElement>('[data-submit]');
    let index = 0;
    let started = false;

    const value = (name: string) => {
      const field = form.querySelector<HTMLInputElement>(`[name="${name}"]:checked`) ?? form.querySelector<HTMLInputElement>(`[name="${name}"]`);
      return field?.value?.trim() ?? '';
    };

    const show = (nextIndex: number) => {
      index = nextIndex;
      steps.forEach((step, i) => { step.hidden = i !== index; });
      if (progress) progress.textContent = `Step ${index + 1} of ${steps.length}`;
      if (back) back.hidden = index === 0;
      if (next) next.hidden = index === steps.length - 1;
      if (submit) submit.hidden = index !== steps.length - 1;
    };

    const markStart = () => {
      if (started) return;
      started = true;
      track('qualifier_start', { form: 'start-your-home' });
    };

    form.addEventListener('change', markStart);

    form.addEventListener('focusin', () => {
      if (form.dataset.started) return;
      form.dataset.started = 'true';
      track('form_start', { form: 'start-your-home' });
    }, { once: true });

    next?.addEventListener('click', () => show(Math.min(index + 1, steps.length - 1)));
    back?.addEventListener('click', () => show(Math.max(index - 1, 0)));

    form.addEventListener('submit', async (event) => {
      event.preventDefault();
      const name = value('name');
      const phone = value('phone');
      const email = value('email');
      if (!name || (!phone && !email)) {
        if (status) {
          status.hidden = false;
          status.textContent = 'Add your name, and a phone number or email, so we can reply.';
        }
        return;
      }
      if (String(new FormData(form).get('company') ?? '').trim()) return;
      const areaNote = value('area-note');
      const area = [value('area'), areaNote].filter(Boolean).join(', ');
      const payload = new FormData(form);
      if (area) payload.set('area', area);
      let sent = false;
      try {
        const response = await fetch(form.action, { method: 'POST', body: payload });
        sent = response.ok;
      } catch {
        sent = false;
      }
      if (sent) {
        track('qualifier_complete', { form: 'start-your-home' });
        track('quote_submit', { form: 'start-your-home' });
      }
      const thanks = new URL('/contact/thanks/', location.origin);
      thanks.searchParams.set('sent', sent ? '1' : '0');
      thanks.searchParams.set('name', name);
      if (phone) thanks.searchParams.set('phone', phone);
      if (email) thanks.searchParams.set('email', email);
      if (value('work')) thanks.searchParams.set('work', value('work'));
      if (area) thanks.searchParams.set('area', area);
      if (value('land')) thanks.searchParams.set('land', value('land'));
      if (value('timeline')) thanks.searchParams.set('timeline', value('timeline'));
      location.assign(thanks.pathname + thanks.search);
    });

    show(0);
  }
</script>
