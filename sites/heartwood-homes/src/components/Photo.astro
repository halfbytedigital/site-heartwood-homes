---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  src: ImageMetadata;
  alt: string;
  credit?: string | null;
  rendering?: boolean;
  sizes: string;
  priority?: boolean;
}
const { src, alt, credit = null, rendering = false, sizes, priority = false } = Astro.props;
---
<figure class="photo">
  <Image
    src={src}
    alt={alt}
    widths={[640, 960, 1280, 1600]}
    sizes={sizes}
    loading={priority ? 'eager' : 'lazy'}
    fetchpriority={priority ? 'high' : 'auto'}
  />
  {(credit || rendering) && (
    <figcaption>
      {rendering ? 'Architectural rendering from the current Heartwood Homes site. ' : ''}
      {credit}
    </figcaption>
  )}
</figure>
