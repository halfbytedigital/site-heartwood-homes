---
import { Image } from 'astro:assets';
import { jobFilters, projectPath, typesFor, type Project } from '../data/projects';
import SaveHouse from './SaveHouse.astro';

interface Props {
  projects: Project[];
}
const { projects } = Astro.props;
const counts = Object.fromEntries(
  jobFilters.map((filter) => [
    filter.slug,
    filter.slug === 'all'
      ? projects.length
      : projects.filter((project) => typesFor(project.slug).includes(filter.slug)).length,
  ]),
);
const pad = (n: number) => String(n).padStart(2, '0');
---
<section class="section project-index" data-project-filters data-project-rail>
  <div class="container project-index-head">
    <h1>Homes we've built.</h1>
    <div class="project-filters">
      <div class="filter-chips" role="group" aria-label="Filter projects by type">
        {jobFilters.map((filter) => (
          <button type="button" data-filter={filter.slug} aria-pressed={filter.slug === 'all' ? 'true' : 'false'}>
            {filter.label} <span class="filter-count">{counts[filter.slug]}</span>
          </button>
        ))}
      </div>
    </div>
  </div>
  <div class="project-rail">
    <ol class="project-rail-track" data-rail-track tabindex="0" aria-label="Project photos">
      {projects.map((project, index) => (
        <li class="project-rail-card" data-rail-card data-types={typesFor(project.slug).join(' ')}>
          <a class="project-rail-link" href={projectPath(project.slug)} aria-label={project.name}>
            <Image
              src={project.image}
              alt=""
              widths={[480, 720, 960]}
              sizes="(min-width: 1100px) 240px, 78vw"
            />
            <span class="shade" aria-hidden="true"></span>
            <span class="top">
              <span class="date">{project.dates}</span>
              <span class="title">{project.name}</span>
            </span>
            <span class="bottom">
              <span class="index">{pad(index + 1)}</span>
              <svg class="arrow" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
                <path d="M7 17L17 7M9 7h8v8" fill="none" stroke="currentColor" stroke-width="1.5" />
              </svg>
            </span>
          </a>
          <SaveHouse slug={project.slug} name={project.name} />
        </li>
      ))}
    </ol>
    <div class="container project-rail-chrome">
      <p class="project-rail-count" data-rail-count>01 / {pad(projects.length)}</p>
      <div class="project-rail-scroll">
        <label class="visually-hidden" for="project-rail-scroll">Scroll projects</label>
        <input id="project-rail-scroll" type="range" min="0" max="1" value="0" step="1" data-rail-scroll />
      </div>
      <div class="project-rail-buttons">
        <button type="button" data-rail-prev aria-label="Previous projects">
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M15 6L9 12l6 6" fill="none" stroke="currentColor" stroke-width="1.5" /></svg>
        </button>
        <button type="button" data-rail-next aria-label="Next projects">
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M9 6l6 6-6 6" fill="none" stroke="currentColor" stroke-width="1.5" /></svg>
        </button>
      </div>
    </div>
  </div>
</section>
