---
import { Image } from 'astro:assets';
import { roomGroups, shotWidths, type Gallery, type Shot } from '../data/galleries';
import { projectPath, type Project } from '../data/projects';

interface Props {
  gallery: Gallery;
  next?: Project[];
}
const { gallery, next = [] } = Astro.props;
const day = gallery.shots.find((shot) => shot.role === 'day');
const dusk = gallery.shots.find((shot) => shot.role === 'dusk');
const details = gallery.shots.filter((shot) => shot.role === 'detail');
const body = gallery.shots.filter((shot) => shot.role === 'spread');
const { groups, unlabeled } = roomGroups(body);
const showRooms = gallery.pattern === 'rooms' && groups.length > 1;

function pairs(shots: Shot[]) {
  const rows: Shot[][] = [];
  for (let i = 0; i < shots.length; i += 2) rows.push(shots.slice(i, i + 2));
  return rows;
}

function roomId(label: string) {
  return `room-${label.toLowerCase().replace(/[^a-z0-9]+/g, '-')}`;
}
---
<div class:list={['story', { 'story-modest': gallery.modest }]} data-story>
  {day && dusk && (
    <section class="section" aria-labelledby="day-dusk-title">
      <div class="container stack">
        <h2 id="day-dusk-title">Day and dusk</h2>
        <p class="measure">The same front of the cabin, in daylight and at dusk.</p>
        <div class="day-dusk">
          <figure class="shot">
            <Image src={day.src} alt={day.alt} widths={shotWidths(day)} sizes="(min-width: 800px) 1240px, 100vw" data-day />
            <Image src={dusk.src} alt={dusk.alt} widths={shotWidths(dusk)} sizes="(min-width: 800px) 1240px, 100vw" data-dusk hidden />
            <figcaption><span data-day-label>Daytime</span></figcaption>
            <button type="button" class="view-btn" data-view data-alt="The A-frame cabin">View larger</button>
          </figure>
          <label class="day-dusk-control" for="day-dusk-range">
            Day to dusk
            <input id="day-dusk-range" type="range" min="0" max="1" step="1" value="0" />
          </label>
        </div>
      </div>
    </section>
  )}

  {gallery.pattern === 'build' && gallery.phases.map((phase) => {
    const shots = gallery.shots.filter((shot) => shot.phase === phase.id);
    return (
      <section class="section" id={phase.id}>
        <div class="container stack">
          <h2>{phase.label}</h2>
          <p class="measure">{phase.text}</p>
          {pairs(shots).map((row) => (
            <div class:list={['spread', row.length > 1 ? 'spread-two' : 'spread-full']}>
              {row.map((shot) => (
                <figure class="shot">
                  <Image src={shot.src} alt={shot.alt} widths={shotWidths(shot)} sizes={row.length > 1 ? '(min-width: 800px) 600px, 100vw' : '(min-width: 800px) 1240px, 100vw'} />
                  <button type="button" class="view-btn" data-view data-alt={shot.alt}>View larger</button>
                </figure>
              ))}
            </div>
          ))}
        </div>
      </section>
    );
  })}

  {gallery.pattern !== 'build' && showRooms && (
    <div class="container room-layout">
      <nav class="room-index" aria-label="Rooms">
        {groups.map((group) => <a href={`#${roomId(group.label)}`}>{group.label}</a>)}
      </nav>
      <div class="stack">
        {groups.map((group) => (
          <section class="stack" id={roomId(group.label)}>
            <h2>{group.label}</h2>
            {pairs(group.shots).map((row) => (
              <div class:list={['spread', row.length > 1 ? 'spread-two' : 'spread-full']}>
                {row.map((shot) => (
                  <figure class="shot" style={gallery.modest ? `max-width:${shot.width}px` : undefined}>
                    <Image src={shot.src} alt={shot.alt} widths={shotWidths(shot)} sizes={row.length > 1 ? '(min-width: 800px) 480px, 100vw' : '(min-width: 800px) 800px, 100vw'} />
                    <button type="button" class="view-btn" data-view data-alt={shot.alt}>View larger</button>
                  </figure>
                ))}
              </div>
            ))}
          </section>
        ))}
        {unlabeled.length > 0 && pairs(unlabeled).map((row) => (
          <div class:list={['spread', row.length > 1 ? 'spread-two' : 'spread-full']}>
            {row.map((shot) => (
              <figure class="shot" style={gallery.modest ? `max-width:${shot.width}px` : undefined}>
                <Image src={shot.src} alt={shot.alt} widths={shotWidths(shot)} sizes="(min-width: 800px) 800px, 100vw" />
                <button type="button" class="view-btn" data-view data-alt={shot.alt}>View larger</button>
              </figure>
            ))}
          </div>
        ))}
      </div>
    </div>
  )}

  {gallery.pattern !== 'build' && !showRooms && (
    <section class="section">
      <div class="container stack">
        {pairs(gallery.shots.filter((shot) => shot.role !== 'detail')).map((row, index) => (
          <div class:list={['spread', index % 3 === 0 || row.length === 1 ? 'spread-full' : 'spread-two']}>
            {row.map((shot) => (
              <figure class="shot" style={gallery.modest ? `max-width:${shot.width}px` : undefined}>
                <Image src={shot.src} alt={shot.alt} widths={shotWidths(shot)} sizes="(min-width: 800px) 1240px, 100vw" />
                {shot.label && gallery.pattern === 'bucket' ? null : shot.label && <figcaption>{shot.label}</figcaption>}
                <button type="button" class="view-btn" data-view data-alt={shot.alt}>View larger</button>
              </figure>
            ))}
          </div>
        ))}
      </div>
    </section>
  )}

  {details.length > 0 && (
    <section class="section">
      <div class="container stack">
        <h2>Details</h2>
        <div class="spread spread-two">
          {details.map((shot) => (
            <figure class="shot">
              <Image src={shot.src} alt={shot.alt} widths={shotWidths(shot)} sizes="(min-width: 800px) 600px, 100vw" />
              {shot.label && <figcaption>{shot.label}</figcaption>}
              <button type="button" class="view-btn" data-view data-alt={shot.alt}>View larger</button>
            </figure>
          ))}
        </div>
      </div>
    </section>
  )}

  {gallery.credit && (
    <div class="container">
      <p class="muted story-credit">{gallery.credit}</p>
    </div>
  )}

  {next.length > 0 && (
    <section class="section">
      <div class="container stack">
        <h2>Another house</h2>
        <div class="next-houses">
          {next.map((house) => (
            <a class="next-house" href={projectPath(house.slug)}>
              <Image src={house.image} alt="" widths={[480, 800]} sizes="(min-width: 800px) 400px, 100vw" />
              <span>{house.name}</span>
            </a>
          ))}
        </div>
      </div>
    </section>
  )}

  <dialog class="viewer" data-viewer>
    <button type="button" class="view-btn" data-viewer-close>Close</button>
    <button type="button" class="view-btn" data-viewer-prev>Previous</button>
    <img alt="" data-viewer-frame />
    <button type="button" class="view-btn" data-viewer-next>Next</button>
    <p data-viewer-count></p>
  </dialog>
</div>

<script>
  document.querySelectorAll<HTMLElement>('[data-story]').forEach((root) => {
    const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    const dialog = root.querySelector<HTMLDialogElement>('[data-viewer]');
    const frame = root.querySelector<HTMLImageElement>('[data-viewer-frame]');
    const count = root.querySelector<HTMLElement>('[data-viewer-count]');
    const buttons = [...root.querySelectorAll<HTMLButtonElement>('[data-view]')];
    let index = 0;
    let touchX = 0;

    const show = (nextIndex: number) => {
      if (!buttons.length || !frame) return;
      index = (nextIndex + buttons.length) % buttons.length;
      const button = buttons[index];
      const picture = button.parentElement?.querySelectorAll('img');
      const visible = picture ? [...picture].find((img) => !img.hidden) : undefined;
      frame.src = visible?.currentSrc || visible?.src || '';
      frame.alt = button.dataset.alt || visible?.alt || '';
      if (count) count.textContent = `${index + 1} of ${buttons.length}`;
    };

    buttons.forEach((button, i) => {
      button.addEventListener('click', () => {
        show(i);
        dialog?.showModal();
      });
    });
    root.querySelector('[data-viewer-close]')?.addEventListener('click', () => dialog?.close());
    root.querySelector('[data-viewer-prev]')?.addEventListener('click', () => show(index - 1));
    root.querySelector('[data-viewer-next]')?.addEventListener('click', () => show(index + 1));
    dialog?.addEventListener('keydown', (event) => {
      if (event.key === 'ArrowRight') { event.preventDefault(); show(index + 1); }
      if (event.key === 'ArrowLeft') { event.preventDefault(); show(index - 1); }
    });
    dialog?.addEventListener('touchstart', (event) => { touchX = event.changedTouches[0]?.clientX ?? 0; }, { passive: true });
    dialog?.addEventListener('touchend', (event) => {
      const delta = (event.changedTouches[0]?.clientX ?? 0) - touchX;
      if (Math.abs(delta) < 40) return;
      show(delta < 0 ? index + 1 : index - 1);
    }, { passive: true });
    if (reduce && frame) frame.style.transition = 'none';

    const range = root.querySelector<HTMLInputElement>('#day-dusk-range');
    const dayImg = root.querySelector<HTMLImageElement>('[data-day]');
    const duskImg = root.querySelector<HTMLImageElement>('[data-dusk]');
    const dayLabel = root.querySelector<HTMLElement>('[data-day-label]');
    range?.addEventListener('input', () => {
      const duskOn = range.value === '1';
      if (dayImg) dayImg.hidden = duskOn;
      if (duskImg) duskImg.hidden = !duskOn;
      if (dayLabel) dayLabel.textContent = duskOn ? 'Dusk' : 'Daytime';
    });
  });
</script>
