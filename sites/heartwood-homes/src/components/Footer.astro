---
import { site } from '../data/site';
import { nav, moreNav, contactHref, planHref, planLabel } from '../data/nav';
const year = new Date().getFullYear();
---
<footer class="site-footer">
  <div class="container">
    {site.phone && site.phoneE164 && (
      <a class="footer-phone" href={`tel:${site.phoneE164}`} data-event="call_click" data-event-placement="footer">{site.phone}</a>
    )}
    <div class="footer-row">
      <a class="text-link" href={planHref} data-start-cta><span data-start-cta-label>{planLabel}</span></a>
      {site.email && <a class="text-link" href={`mailto:${site.email}`} data-event="email_click">{site.email}</a>}
    </div>
    <nav class="footer-links" aria-label="Footer">
      {nav.map((item) => <a href={item.href}>{item.label}</a>)}
      {moreNav.map((item) => <a href={item.href}>{item.label}</a>)}
      <a href={contactHref}>Contact</a>
      <a href="/privacy/">Privacy</a>
      {site.socials.facebook && <a href={site.socials.facebook}>Facebook</a>}
      {site.socials.instagram && <a href={site.socials.instagram}>Instagram</a>}
    </nav>
    <div class="footer-meta">
      <p class="muted">© {year} {site.legalName ?? site.name}</p>
      {site.yearFounded && <p class="muted">Founded {site.yearFounded}</p>}
      {site.areaServed?.map((area) => <p class="muted">Serving {area}</p>)}
      <p class="muted">Website by Half Byte Digital</p>
    </div>
  </div>
</footer>
